{
  "compilerOptions": {
    "baseUrl": "./src",
    "outDir": "./dist",
    "module": "commonjs",
    "noImplicitAny": true,
    "target": "es5",
    "allowJs": true,
    "moduleResolution": "node",
    "esModuleInterop": true,
    "declaration": true,
    "strict": true,
    "strictNullChecks": true,
    "lib": [
      // "esnext"
      "es6",
      "dom"
    ],
    "declarationDir": "./dist",
    "rootDir": "./src",
    "composite": false,
    "emitDeclarationOnly": true,
    "skipLibCheck": true
  },
  "exclude": ["esbuild.ts", "dist"]
}
